{
  "name": "@agenttrial/research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./analysis": "./src/analysis.ts",
    "./controlled-agents": "./src/controlled-agents.ts",
    "./local-judge": "./src/local-judge.ts",
    "./oracle-adjudication": "./src/oracle-adjudication.ts",
    "./power-analysis": "./src/power.ts",
    "./target-adapter": "./src/target-adapter.ts",
    "./tamper": "./src/tamper.ts"
  },
  "scripts": {
    "audit:target-bindings": "node --import tsx src/audit-target-bindings.ts",
    "audit:blocker-ledger": "node --import tsx src/blocker-ledger.ts",
    "freeze:artifact-tampering-plan": "node --import tsx src/freeze-artifact-tampering-plan.ts",
    "reconstruct:fixed-upstream-faults": "node --import tsx src/reconstruct-fixed-upstream-faults.ts",
    "refresh:construct-review": "node --import tsx src/refresh-construct-review.ts",
    "freeze": "node --import tsx src/freeze.ts && prettier --write ../../research/design-freeze.json",
    "gate:main-trial": "node --import tsx src/gate-main-trial.ts",
    "pilot": "node --import tsx src/pilot.ts && prettier --write ../../research/pilot/summary.json ../../research/pilot/tamper-summary.json",
    "power": "node --import tsx src/power.ts && prettier --write ../../research/power/power-analysis.json",
    "calibrate:judge": "node --import tsx src/calibrate-judge.ts && prettier --write ../../research/llm-judge/calibration-summary.json"
  },
  "dependencies": {
    "@agenttrial/core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.12"
  }
}
